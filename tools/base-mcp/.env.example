# BASE Developers で作ったアプリの情報（このファイルを .env にコピーして値を入れる）
BASE_CLIENT_ID=
BASE_CLIENT_SECRET=
BASE_REDIRECT_URI=http://localhost:8787/callback

# 認証時に求める権限。書き込みもするなら write_items write_orders を追加
BASE_SCOPES=read_users read_items read_orders

# 1 にすると書き込みツール（在庫・商品・注文ステータス変更）を有効化
BASE_ALLOW_WRITE=0

# リモート版（server-http.mjs）用：URLに含める32文字以上の秘密文字列
# 作り方: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BASE_MCP_SECRET=

# リモート版（server-http.mjs）でお客さま情報ツールを出すか。個人情報を扱うので既定は無効（0）
BASE_ALLOW_CUSTOMER_DATA=0
